# PostgreSQL connection string. The database needs the pgvector extension
# available (RDS, Neon, Supabase, or `docker run pgvector/pgvector:pg17` locally).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tributary

# LLM backend: `claude` (headless Claude Code CLI, default) or `openai` (any
# OpenAI-compatible API; the defaults below target DeepSeek). For openai:
# pip install -e ".[openai]" and set LLM_API_KEY.
LLM_BACKEND=claude
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=

# LLM: headless Claude Code CLI (`claude -p`) — uses whatever auth your local
# `claude` binary has (subscription or API key). Alias or full model name.
CLAUDE_CODE_MODEL=sonnet

# Lesson classifier tiers. The cheap tier classifies every new lesson; the
# strong tier re-checks contradictions and low-confidence verdicts. Either can
# be `jev` (TypeSafe's classification model: pip install -e ".[jev]" and set
# TYPESAFE_API_KEY) or an LLM model name. Unset = derived from the LLM backend.
# CLASSIFY_MODEL_CHEAP=jev
# CLASSIFY_MODEL_STRONG=
# CLASSIFY_ESCALATE_BELOW=0.75
TYPESAFE_API_KEY=
# TYPESAFE_DEFAULT_MODEL=jev-latest   # pin e.g. jev-1.13.0 once thresholds are tuned

# Injection screen, second layer (regex always runs first): `jev` (one yes/no
# question per hazard, ~0.25 s) or an LLM model name (~10 s via claude -p).
# SCREEN_MODEL=jev
# SCREEN_JEV_THRESHOLD=0.70

# Logging (always to stderr; never stdout, which the MCP server uses).
TRIBUTARY_LOG_LEVEL=INFO          # DEBUG shows prompts, candidates, per-answer probabilities
TRIBUTARY_LOG_FORMAT=text         # or json (one object per line)
# TRIBUTARY_LOG_FILE=tributary.log # also append JSON lines here (rotating)

# Embeddings: local sentence-transformers model (must produce 1024-d vectors
# to match the VECTOR(1024) schema column).
EMBED_MODEL_ID=BAAI/bge-large-en-v1.5

# Set to 1 to run without any models (deterministic fake embeddings + heuristic
# classifier). Useful for local dev and the conflict tests. Leave unset otherwise.
TRIBUTARY_OFFLINE=
