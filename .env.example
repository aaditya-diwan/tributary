# CockroachDB Cloud connection string (from Cloud Console or `ccloud cluster sql --connection-url`)
DATABASE_URL=postgresql://user:password@your-cluster.cockroachlabs.cloud:26257/tributary?sslmode=verify-full

# AWS / Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# Set to 1 to run without AWS (deterministic fake embeddings + heuristic classifier).
# Useful for local dev and the conflict tests. Leave unset in production.
TRIBUTARY_OFFLINE=
